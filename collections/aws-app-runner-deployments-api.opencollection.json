{
  "opencollection": "1.0.0",
  "info": {
    "name": "AWS App Runner Auto Scaling Deployments API",
    "version": "2020-05-15"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Deployments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "AWS App Runner Start a Deployment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://apprunner.{region}.amazonaws.com/#StartDeployment",
            "headers": [
              {
                "name": "X-Amz-Target",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Initiate a manual deployment of the latest commit in a source code repository or the latest image in a source image repository."
        },
        {
          "info": {
            "name": "AWS App Runner List Operations",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://apprunner.{region}.amazonaws.com/#ListOperations",
            "headers": [
              {
                "name": "X-Amz-Target",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Return a list of operations that occurred on an App Runner service."
        }
      ]
    }
  ],
  "bundled": true
}